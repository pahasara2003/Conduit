<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="send_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_send"
        android:shortcutShortLabel="@string/shortcut_send_short"
        android:shortcutLongLabel="@string/shortcut_send_long">
        <intent
            android:action="com.example.clipsync.ACTION_SEND_CLIPBOARD"
            android:targetPackage="com.example.clipsync"
            android:targetClass="com.example.clipsync.QuickActionActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="pull_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_pull"
        android:shortcutShortLabel="@string/shortcut_pull_short"
        android:shortcutLongLabel="@string/shortcut_pull_long">
        <intent
            android:action="com.example.clipsync.ACTION_PULL_CLIPBOARD"
            android:targetPackage="com.example.clipsync"
            android:targetClass="com.example.clipsync.QuickActionActivity" />
    </shortcut>
</shortcuts>
